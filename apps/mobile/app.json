{
  "expo": {
    "name": "mxrvs",
    "slug": "mxrvs",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mxrvs",
    "icon": "./assets/mxrvs.png",
    "splash": {
      "image": "./assets/mxrvs.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "image": "./assets/mxrvs.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B0F0C"
      }
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.mxrvs",
      "infoPlist": {
        "NSMotionUsageDescription": "Allow mxrvs to count daily steps and steps during cardio sessions.",
        "NSLocationWhenInUseUsageDescription": "Allow mxrvs to track your running routes."
      }
    },
    "android": {
      "package": "com.anonymous.mxrvs",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/mxrvs.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow mxrvs to track your runs.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow mxrvs to count daily steps and steps during cardio sessions."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow mxrvs to access workout and cardio images.",
          "savePhotosPermission": "Allow mxrvs to save workout and cardio images."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow mxrvs to choose workout and cardio export backgrounds.",
          "cameraPermission": "Allow mxrvs to take workout and cardio export backgrounds."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf2a8954-6ab4-499b-a7cb-51de808fae29"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/bf2a8954-6ab4-499b-a7cb-51de808fae29"
    }
  }
}
